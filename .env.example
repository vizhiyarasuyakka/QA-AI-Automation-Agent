# PostgreSQL connection (docker-compose.yml publishes the database on 5433)
DATABASE_URL="postgresql://qa:qa@localhost:5433/qa_workflow?schema=public"

# Required. Signs the sign-in cookie (32+ characters) and encrypts stored passwords and tokens (32 bytes, base64).
# Generate both with: npm run keys -- --write
# Keep SECRETS_KEY safe and backed up: without it, saved test-account passwords and tokens cannot be read.
AUTH_SECRET=""
SECRETS_KEY=""
# Optional. "true" forces the Secure cookie flag; by default it follows X-Forwarded-Proto from your HTTPS proxy.
AUTH_COOKIE_SECURE=""

# Optional single sign-on (OpenID Connect; Microsoft Entra ID shown). Register a web app in Entra with the redirect URI
# https://<this site>/login/oidc/callback, then fill these in. Use your tenant's issuer, never "common".
# OIDC_ISSUER: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI: optional; set it when the app runs behind a proxy
OIDC_REDIRECT_URI=""
# OIDC_ALLOWED_DOMAINS: optional, e.g. company.com; who may get an account at first sign-in
OIDC_ALLOWED_DOMAINS=""
# OIDC_DEFAULT_ROLE: role for new accounts, default Viewer (never Admin)
OIDC_DEFAULT_ROLE=""
# OIDC_ONLY: "true" hides the password form; /login?password=1 still shows it for a break-glass Admin
OIDC_ONLY=""

# Optional. "docker" runs Playwright scripts in the official Playwright container instead of on this server.
SCRIPT_SANDBOX=""
# SCRIPT_SANDBOX_IMAGE: optional override of mcr.microsoft.com/playwright:v<installed version>-noble
SCRIPT_SANDBOX_IMAGE=""

# Optional. Leave empty to generate test cases through this machine's Claude Code login. A key here takes priority.
ANTHROPIC_API_KEY=""
# Optional. "true" allows Claude only through ANTHROPIC_API_KEY (set this on any shared server).
AI_REQUIRE_API_KEY=""
# Model used for generation
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: webhook that receives every logged bug as JSON (your in-house QA app)
BUG_WEBHOOK_URL=""
# Optional: bearer token sent as Authorization header to the webhook
BUG_WEBHOOK_TOKEN=""
# Required for CI imports (Playwright, Newman): 16+ characters, sent as the X-Import-Token header.
# With no token, /api/import/* refuses every request. Can also be set in Settings by an Admin.
IMPORT_TOKEN=""
