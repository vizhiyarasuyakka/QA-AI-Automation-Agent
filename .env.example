# PostgreSQL connection (docker-compose below starts one on 5432)
DATABASE_URL="postgresql://qa:qa@localhost:5432/qa_workflow?schema=public"
# Optional. Leave empty to generate test cases through this machine's Claude Code login. A key here takes priority.
ANTHROPIC_API_KEY=""
# Model used for generation
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: webhook that receives every logged bug as JSON (your in-house QA app)
BUG_WEBHOOK_URL=""
# Optional: bearer token sent as Authorization header to the webhook
BUG_WEBHOOK_TOKEN=""
# Optional: shared secret for the import endpoints (Playwright, Newman). Send as X-Import-Token header.
IMPORT_TOKEN=""
